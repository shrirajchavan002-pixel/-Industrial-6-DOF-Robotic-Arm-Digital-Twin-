<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="industrial_orange"><color rgba="1.0 0.4 0.0 1.0"/></material>
    <material name="industrial_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
    <material name="industrial_black"><color rgba="0.1 0.1 0.1 1.0"/></material>

    <!-- World and Base -->
    <link name="world"/>
    <joint name="world_to_base" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual><origin xyz="0 0 0.025" rpy="0 0 0"/><geometry><cylinder radius="0.1" length="0.05"/></geometry><material name="industrial_grey"/></visual>
        <collision><origin xyz="0 0 0.025" rpy="0 0 0"/><geometry><cylinder radius="0.1" length="0.05"/></geometry></collision>
        <xacro:inertial_cylinder mass="5.0" length="0.05" radius="0.1"><origin xyz="0 0 0.025" rpy="0 0 0"/></xacro:inertial_cylinder>
    </link>

    <!-- JOINT 1 & LINK 1 (Shoulder) -->
    <joint name="joint_1" type="revolute">
        <parent link="base_link"/><child link="link_1"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="1.5"/>
    </joint>
    <link name="link_1">
        <visual><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><cylinder radius="0.06" length="0.2"/></geometry><material name="industrial_orange"/></visual>
        <collision><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><cylinder radius="0.06" length="0.2"/></geometry></collision>
        <xacro:inertial_cylinder mass="4.0" length="0.2" radius="0.06"><origin xyz="0 0 0.1" rpy="0 0 0"/></xacro:inertial_cylinder>
    </link>

    <!-- JOINT 2 & LINK 2 (Upper Arm) -->
    <joint name="joint_2" type="revolute">
        <parent link="link_1"/><child link="link_2"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="150.0" velocity="1.5"/>
    </joint>
    <link name="link_2">
        <visual><origin xyz="0 0 0.2" rpy="0 0 0"/><geometry><cylinder radius="0.05" length="0.4"/></geometry><material name="industrial_orange"/></visual>
        <collision><origin xyz="0 0 0.2" rpy="0 0 0"/><geometry><cylinder radius="0.05" length="0.4"/></geometry></collision>
        <xacro:inertial_cylinder mass="5.0" length="0.4" radius="0.05"><origin xyz="0 0 0.2" rpy="0 0 0"/></xacro:inertial_cylinder>
    </link>

    <!-- JOINT 3 & LINK 3 (Forearm) -->
    <joint name="joint_3" type="revolute">
        <parent link="link_2"/><child link="link_3"/>
        <origin xyz="0 0 0.4" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.356" upper="2.356" effort="100.0" velocity="2.0"/>
    </joint>
    <link name="link_3">
        <visual><origin xyz="0 0 0.15" rpy="0 0 0"/><geometry><cylinder radius="0.04" length="0.3"/></geometry><material name="industrial_orange"/></visual>
        <collision><origin xyz="0 0 0.15" rpy="0 0 0"/><geometry><cylinder radius="0.04" length="0.3"/></geometry></collision>
        <xacro:inertial_cylinder mass="3.0" length="0.3" radius="0.04"><origin xyz="0 0 0.15" rpy="0 0 0"/></xacro:inertial_cylinder>
    </link>

    <!-- JOINT 4 & LINK 4 (Wrist 1) -->
    <joint name="joint_4" type="revolute">
        <parent link="link_3"/><child link="link_4"/>
        <origin xyz="0 0 0.3" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="2.5"/>
    </joint>
    <link name="link_4">
        <visual><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.1"/></geometry><material name="industrial_black"/></visual>
        <collision><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.1"/></geometry></collision>
        <xacro:inertial_cylinder mass="1.0" length="0.1" radius="0.035"><origin xyz="0 0 0.05" rpy="0 0 0"/></xacro:inertial_cylinder>
    </link>

    <!-- JOINT 5 & LINK 5 (Wrist 2) -->
    <joint name="joint_5" type="revolute">
        <parent link="link_4"/><child link="link_5"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="50.0" velocity="2.5"/>
    </joint>
    <link name="link_5">
        <visual><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.1"/></geometry><material name="industrial_black"/></visual>
        <collision><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.1"/></geometry></collision>
        <xacro:inertial_cylinder mass="1.0" length="0.1" radius="0.035"><origin xyz="0 0 0.05" rpy="0 0 0"/></xacro:inertial_cylinder>
    </link>

    <!-- JOINT 6 & LINK 6 (Tool Flange) -->
    <joint name="joint_6" type="revolute">
        <parent link="link_5"/><child link="link_6"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="25.0" velocity="3.0"/>
    </joint>
    <link name="link_6">
        <visual><origin xyz="0 0 0.01" rpy="0 0 0"/><geometry><cylinder radius="0.04" length="0.02"/></geometry><material name="industrial_grey"/></visual>
        <collision><origin xyz="0 0 0.01" rpy="0 0 0"/><geometry><cylinder radius="0.04" length="0.02"/></geometry></collision>
        <xacro:inertial_cylinder mass="0.5" length="0.02" radius="0.04"><origin xyz="0 0 0.01" rpy="0 0 0"/></xacro:inertial_cylinder>
    </link>

    <!-- TOOL FRAME (TCP) -->
    <joint name="joint_tool0" type="fixed">
        <parent link="link_6"/>
        <child link="tool0"/>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </joint>
    <link name="tool0"/>

</robot>
